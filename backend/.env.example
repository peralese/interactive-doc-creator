# Application Settings
APP_NAME=Interactive Document Creator
APP_VERSION=0.1.0
DEBUG=false

# Server Configuration
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Database
DATABASE_URL=sqlite+aiosqlite:///../data/sessions.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost/dbname

# Storage Paths
AUDIO_STORAGE_PATH=../data/audio
SESSION_STORAGE_PATH=../data/sessions
TEMPLATE_STORAGE_PATH=../templates

# LLM Configuration
LLM_DEFAULT_PROVIDER=openai

# Quick Capture LLM provider — ollama keeps data local, openai sends to cloud
# Valid values: ollama, openai
CAPTURE_LLM_PROVIDER=ollama

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TEMPERATURE=1

# Anthropic Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-sonnet-20240229
ANTHROPIC_TEMPERATURE=0.7

# Ollama Configuration (Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TEMPERATURE=0.7

# Whisper Configuration
WHISPER_MODEL=base
WHISPER_LANGUAGE=en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
MAX_AUDIO_SIZE=100000000
MAX_REQUIREMENTS_SIZE=1000000

# Document Generation
MAX_DOCUMENT_SIZE=1000000
SUPPORTED_EXPORT_FORMATS=["markdown","pdf","docx","html"]

# Session Management
SESSION_TIMEOUT_MINUTES=60
MAX_SESSIONS_PER_USER=10
AUTO_SAVE_INTERVAL_SECONDS=30

# Security
SECRET_KEY=change-this-to-a-random-secret-key-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
